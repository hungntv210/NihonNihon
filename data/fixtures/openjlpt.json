  "grammar": [
    {
      "id": "wa",
      "pattern": "〜は",
      "romaji": "wa",
      "level": "N5",
      "meaning": "as for; marks the topic of the sentence",
      "formation": "Noun + は",
      "examples": [
        {
          "ja": "私は学生です。",
          "furigana": "{私|わたし}は{学生|がくせい}です。",
          "en": "I am a student."
        },
        {
          "ja": "今日は天気がいいです。",
          "furigana": "{今日|きょう}は{天気|てんき}がいいです。",
          "en": "The weather is nice today."
        },
        {
          "ja": "この本はおもしろいです。",
          "furigana": "この{本|ほん}はおもしろいです。",
          "en": "This book is interesting."
        }
      ],
      "tags": [
        "particle",
        "topic"
      ],
      "notes": "Written は but pronounced 'wa'. It sets up what the sentence is about; the key information comes after it."
    },
    {
      "id": "ga-subject",
      "pattern": "〜が（subject）",
      "romaji": "ga (subject)",
      "level": "N5",
      "meaning": "marks the subject; points out new or focused information",
      "formation": "Noun + が",
      "examples": [
        {
          "ja": "雨が降っています。",
          "furigana": "{雨|あめ}が{降|ふ}っています。",
          "en": "It is raining."
        },
        {
          "ja": "だれが窓を開けましたか。",
          "furigana": "だれが{窓|まど}を{開|あ}けましたか。",
          "en": "Who opened the window?"
        },
        {
          "ja": "私が行きます。",
          "furigana": "{私|わたし}が{行|い}きます。",
          "en": "I'll be the one to go."
        }
      ],
      "tags": [
        "particle"
      ],
      "notes": "Question words such as だれ and 何 take が, never は, when they are the subject. が is also used with 好き, ほしい, 上手 and わかる for the thing liked, wanted or understood."
    },
    {
      "id": "o",
      "pattern": "〜を",
      "romaji": "o",
      "level": "N5",
      "meaning": "marks the direct object of a verb; marks a place moved through or left",
      "formation": "Noun + を",
      "examples": [
        {
          "ja": "毎朝パンを食べます。",
          "furigana": "{毎朝|まいあさ}パンを{食|た}べます。",
          "en": "I eat bread every morning."
        },
        {
          "ja": "姉は新しいかばんを買いました。",
          "furigana": "{姉|あね}は{新|あたら}しいかばんを{買|か}いました。",
          "en": "My older sister bought a new bag."
        },
        {
          "ja": "公園を散歩しました。",
          "furigana": "{公園|こうえん}を{散歩|さんぽ}しました。",
          "en": "I took a walk in the park."
        }
      ],
      "tags": [
        "particle"
      ],
      "notes": "Written を but pronounced 'o'. With movement verbs such as 歩く, 散歩する and 出る it marks the route or the place being left."
    }
  ]
