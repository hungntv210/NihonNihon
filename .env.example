# Copy to .env.local. Never use the translation worker's .env or live database here.
APP_ORIGIN=http://localhost:3000
NIHON_DB_PATH=./data/demo.sqlite
# Only an explicit private G1 snapshot may be backed up outside the demo database.
# NIHON_DB_ROLE=snapshot
# Private paths default beside the G1 database; keep them within that directory.
# NIHON_SETTINGS_PATH=./data/settings.json
# NIHON_ROADMAP_PATH=./data/private/today-roadmap.json
# NIHON_RECORDINGS_DIR=./data/recordings
# NIHON_BACKUP_DIR=./data/backups
# Generate with npm run auth:password. No default password.
NIHON_PASSWORD_HASH=
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
