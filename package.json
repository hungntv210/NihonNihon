{
  "name": "nihon-nihon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test prototype/tests/*.test.js && node tools/test.mjs",
    "test:app": "tsx tools/test-app.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:app",
    "data:demo": "tsx tools/seed-demo.ts",
    "auth:password": "tsx tools/hash-password.ts",
    "backup:daily": "tsx tools/backup.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "ts-fsrs": "6.0.0",
    "wanakana": "5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.56.0",
    "tailwindcss": "4.3.4",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
